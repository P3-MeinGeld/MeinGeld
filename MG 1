function finishSetup(){
  const t = today();
  S.profile.name = D.name.trim();
  S.start = { amount: D.start, date: t };
  // validFrom bleibt leer: Der Monatsplan zeigt den ganzen Monat.
  // Gebucht wird trotzdem erst ab dem Tag nach dem Start (siehe txs).
  S.recurring = D.rec.map(r => ({ ...r, validFrom: null, validTo: null }));
  S.settings.horizon = D.horizon;
  S.settings.buysFood = D.buysFood;
  S.pots = [{ id: 'food', food: true, name: 'Essen', emoji: '🍎', photo: null, amount: D.buysFood ? D.food : 0 }, ...D.pots];
  S.bookings = [];
  S.setupDone = true;
  save();
  try { navigator.storage && navigator.storage.persist && navigator.storage.persist(); } catch(e){}
  toast('Gespeichert ✓');
  V.view = 'hint'; render();
}

function act(a, v){
  switch(a){
    case 'startTap':
      if(!S.setupDone){ D = newDraft(); V.view = 'O'; V.ed = null; enterStep(0); }
      else { V.view = 'B'; render(); }
      return;
    case 'go': V.view = v; V.ed = null; V.gsub = null; V.err = ''; V.pinBuf = ''; if(v !== 'G') V.unlocked = false; render(); window.scrollTo(0, 0); return;
    case 'gsub': V.gsub = v || null; V.err = ''; V.pinBuf = ''; render(); return window.scrollTo(0, 0);
    case 'pinKey':
      if(v === 'del') V.pinBuf = V.pinBuf.slice(0, -1);
      else if(V.pinBuf.length < 4){ V.pinBuf += v; if(V.pinBuf.length === 4){ render(); return setTimeout(() => { pinDigit(); render(); }, 180); } }
      return render();
    case 'checkCode': {
      const inp = app.querySelector('[data-in=code]'); const code = (inp ? inp.value : '').toUpperCase().replace(/[^A-Z0-9]/g, '');
      if(S.security && hashStr(code) === S.security.codeHash){ S.security = null; save(); V.unlocked = true; V.gsub = 'pinNew1'; toast('Code stimmt ✓'); }
      else V.err = 'Der Code stimmt nicht. Schau noch einmal genau hin.';
      return render();
    }
    case 'codeDone': V.gsub = null; V.newCode = null; toast('PIN gespeichert ✓'); return render();
    case 'pinStart': requirePin('Zur Sicherheit: Gib deine jetzige PIN ein.', () => { V.gsub = 'pinNew1'; V.pinBuf = ''; V.err = ''; }); return render();
    case 'pinRemove': return ask('Willst du die PIN wirklich entfernen? Dann kann jeder die Einstellungen ändern.', 'Ja, entfernen', () =>
      requirePin('Zur Sicherheit: Gib deine PIN ein, um sie zu entfernen.', () => { S.security = null; save(); toast('PIN entfernt'); }), true);
    case 'gName': V.newName = S.profile.name; V.gsub = 'name'; V.err = ''; return render();
    case 'saveName': if(!V.newName.trim()){ V.err = 'Bitte schreib deinen Namen.'; return render(); } S.profile.name = V.newName.trim(); save(); V.gsub = null; toast('Gespeichert ✓'); return render();
    case 'gNewRec': V.ed = { kind: v, target: 'store', sub: 0, data: { type: v, name: '', amount: 0, rhythm: 'month', day: null, weekday: null, month: null } }; V.err = ''; render(); return window.scrollTo(0, 0);
    case 'recMenu': {
      const r = S.recurring.find(x => x.id === v);
      return dialog(`${r.name}: ${money(r.amount)}, ${rhythmText(r)}`, [
        { label: '✏️ Ändern', cls: 'primary', fn: () => { V.ed = { kind: r.type, target: 'store', editId: r.id, sub: 0, data: { ...r } }; V.num = centsToNum(r.amount); } },
        { label: '🗑️ Löschen', cls: 'danger', fn: () => setTimeout(() => ask(`Willst du „${r.name}“ wirklich löschen? Das gilt ab heute.`, 'Ja, löschen', () => { r.validTo = addDays(today(), -1); save(); toast('Gelöscht'); }, true)) },
        { label: 'Abbrechen' }
      ]);
    }
    case 'gNewPot': V.ed = { kind: 'pot', target: 'store', sub: 0, data: { name: '', emoji: '👕', photo: null, amount: 0 } }; V.err = ''; render(); return window.scrollTo(0, 0);
    case 'potEdit': { const p = S.pots.find(x => x.id === v); V.ed = { kind: 'pot', target: 'store', editId: p.id, sub: 0, data: { ...p } }; V.err = ''; render(); return window.scrollTo(0, 0); }
    case 'potDelete': { const id = V.ed.editId, p = S.pots.find(x => x.id === id);
      return ask(`Willst du den Geld-Topf „${p.name}“ wirklich löschen?`, 'Ja, löschen', () => { S.pots = S.pots.filter(x => x.id !== id); save(); V.ed = null; toast('Gelöscht'); }, true); }
    case 'potPage': V.potPage = (V.potPage || 0) + (+v); return render();
    case 'setH': S.settings.horizon = v; save(); return render();
    case 'setBF': S.settings.buysFood = v === 'yes'; save(); return render();
    case 'setFS': S.settings.fontSize = v; save(); return render();
    case 'backupStart': requirePin('Zur Sicherheit: Gib deine PIN ein, um die Daten zu sichern.', () => { V.gsub = 'backup'; V.err = ''; }); render(); return window.scrollTo(0, 0);
    case 'corrStart': requirePin('Zur Sicherheit: Gib deine PIN ein, um dein Geld zu korrigieren.', () => { V.gsub = 'corr'; V.num = ''; V.corrNeg = false; V.err = ''; }); return render();
    case 'corrNeg': V.corrNeg = v === '1'; return render();
    case 'corrNext': V.corrTo = numToCents(V.num) * (V.corrNeg ? -1 : 1); V.gsub = 'corr2'; return render();
    case 'corrSave': {
      const diff = V.corrTo - balance(today());
      if(diff) S.bookings.push({ id: uid(), type: diff > 0 ? 'in' : 'out', date: today(), amount: Math.abs(diff), text: 'Korrektur', potId: null, corr: true });
      save(); V.gsub = null; toast('Korrigiert ✓'); return render();
    }
    case 'exportFile': {
      let framed = true; try { framed = window.self !== window.top; } catch(e){}
      if(framed){ toast('Geht erst in der fertigen App'); return; }
      try {
        const blob = new Blob([JSON.stringify(S)], { type: 'application/json' });
        const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = `mein-geld-${today()}.json`;
        document.body.appendChild(a); a.click(); a.remove();
        toast('Datei wird gespeichert');
      } catch(e){ toast('Das geht hier nicht. Nimm „Als Text kopieren“.'); }
      return;
    }
    case 'exportCopy':
      try { navigator.clipboard.writeText(JSON.stringify(S)).then(() => toast('Kopiert ✓'), () => toast('Kopieren geht hier nicht')); } catch(e){ toast('Kopieren geht hier nicht'); }
      return;
    case 'importText': { const ta = app.querySelector('[data-in=importText]'); return importData(ta ? ta.value : ''); }
    case 'speak': speak(v); return;
    case 'warn': case 'toF': V.view = 'F'; render(); return window.scrollTo(0, 0);
    case 'sugNo': S.dismissed = S.dismissed || {}; S.dismissed[v] = today().slice(0, 7); save(); return render();
    case 'sugYes': { const [id, amt] = v.split(':'); const p = S.pots.find(x => x.id === id);
      requirePin('Zur Sicherheit: Gib deine PIN ein, um den Geld-Topf zu ändern.', () => { p.amount = +amt; save(); toast('Geändert ✓'); });
      return render(); }
    case 'toC': V.calMonth = today().slice(0, 7); V.cDetail = null; V.view = 'C'; render();
      setTimeout(() => { const r = document.getElementById('todayRow'); if(r) r.scrollIntoView({ block: 'center' }); else window.scrollTo(0, 0); }, 30); return;
    case 'calMonth': {
      let [y, m] = V.calMonth.split('-').map(Number); m += +v; if(m < 1){ m = 12; y--; } if(m > 12){ m = 1; y++; }
      V.calMonth = `${y}-${pad(m)}`; render(); return window.scrollTo(0, 0);
    }
    case 'cItem':
      if(v.startsWith('rec:')) return dialog('Das ist eine regelmäßige Zahlung. Die änderst du in den Einstellungen.', [{ label: '⚙️ Zu den Einstellungen', cls: 'primary', fn: () => { V.view = 'G'; } }, { label: 'OK' }]);
      V.cDetail = v; render(); return window.scrollTo(0, 0);
    case 'cBack': V.cDetail = null; render(); { const r = document.getElementById('todayRow'); if(r) r.scrollIntoView({ block: 'center' }); } return;
    case 'cEdit': case 'cDelete': {
      const b = S.bookings.find(x => x.id === V.cDetail); if(!b) return;
      const old = b.date < addDays(today(), -1);
      const doIt = a === 'cEdit'
        ? () => {
            const p = b.potId ? S.pots.find(q => q.id === b.potId) : null;
            V.tx = { type: b.type, step: 0, date: b.date, editId: b.id, back: 'C',
                     potId: b.type === 'out' ? (p ? p.id : 'other') : null,
                     text: p && b.text === p.name ? '' : b.text, amount: b.amount };
            V.view = b.type === 'out' ? 'D' : 'E'; V.err = '';
          }
        : () => ask('Willst du diese Buchung wirklich löschen?', 'Ja, löschen', () => { S.bookings = S.bookings.filter(x => x.id !== b.id); save(); V.cDetail = null; toast('Gelöscht'); }, true);
      if(old) requirePin('Diese Buchung ist älter als gestern. Gib die PIN ein.', doIt); else doIt();
      render(); return window.scrollTo(0, 0);
    }
    case 'txCancel': { const back = V.tx && V.tx.back; V.tx = null; V.err = ''; V.view = back || 'B'; render(); return window.scrollTo(0, 0); }
    case 'toD': V.tx = newTx('out'); V.err = ''; V.view = 'D'; render(); return window.scrollTo(0, 0);
    case 'toE': V.tx = newTx('in'); V.err = ''; V.view = 'E'; render(); return window.scrollTo(0, 0);
    case 'txDay': {
      const nd = addDays(V.tx.date, +v), minD = S.start ? S.start.date : nd;
      if(nd <= today() && nd >= minD) V.tx.date = nd; return render();
    }
    case 'txPot': V.tx.potId = v; V.err = ''; return render();
    case 'txChip': V.tx.text = v; V.err = ''; return render();
    case 'txNext': {
      const X = V.tx; V.err = '';
      if(X.step === 0){
        if(X.type === 'out' && !X.potId){ V.err = 'Bitte tippe an, wofür.'; return render(); }
        if((X.type === 'in' || X.potId === 'other') && !X.text.trim()){ V.err = 'Bitte schreib, wofür.'; return render(); }
        X.text = X.text.trim(); V.num = centsToNum(X.amount);
      } else if(X.step === 1){
        X.amount = numToCents(V.num);
        if(!X.amount){ V.err = 'Bitte gib einen Betrag ein.'; return render(); }
      }
      X.step++; render(); return window.scrollTo(0, 0);
    }
    case 'txBack': V.tx.amount = numToCents(V.num); V.tx.step = 0; V.err = ''; return render();
    case 'txEdit': V.tx.step = 0; V.err = ''; render(); return window.scrollTo(0, 0);
    case 'txSave': {
      const X = V.tx;
      const rec = { id: X.editId || uid(), type: X.type, date: X.date, amount: X.amount,
        text: X.type === 'out' && X.potId !== 'other' ? (X.text || potName(X.potId).name) : X.text,
        potId: X.type === 'out' && X.potId !== 'other' ? X.potId : null };
      if(X.editId){ const i = S.bookings.findIndex(x => x.id === X.editId); if(i >= 0) S.bookings[i] = rec; else S.bookings.push(rec); }
      else S.bookings.push(rec);
      save(); V.view = X.back || 'B'; if(X.back === 'C'){ V.cDetail = null; V.calMonth = X.date.slice(0, 7); } V.tx = null;
      toast('Gespeichert ✓'); render(); return window.scrollTo(0, 0);
    }

    // Ersteinrichtung
    case 'onext': {
      leaveStep();
      const s = curStep();
      if(s === 'name' && !D.name.trim()){ V.err = 'Bitte schreib deinen Namen.'; return render(); }
      if(s === 'minus' && D.neg === null){ V.err = 'Bitte tippe auf eine Antwort.'; return render(); }
      if(s === 'horizon' && !D.horizon){ V.err = 'Bitte tippe auf eine Antwort.'; return render(); }
      if(s === 'buysFood' && D.buysFood === null){ V.err = 'Bitte tippe auf eine Antwort.'; return render(); }
      if(s === 'food'){
        if(!D.food){ V.err = 'Bitte gib einen Betrag ein. Das ist wichtig für die App.'; return render(); }
        if(D.food < 500){
          const next = () => { V.oStep++; V.err = ''; setTimeout(() => window.scrollTo(0, 0)); };
          return dialog(`Du hast ${money(D.food)} am Tag eingegeben. Das ist sehr wenig für einen ganzen Tag. Unser Vorschlag: 5\u00a0€ am Tag.`, [
            { label: `5\u00a0€ nehmen`, cls: 'primary', fn: () => { D.food = 500; next(); } },
            { label: `Bei ${money(D.food)} bleiben`, fn: next },
            { label: 'Neuen Betrag eingeben', fn: () => { V.num = ''; } }
          ]);
        }
      }
      return enterStep(V.oStep + 1);
    }
    case 'oback': leaveStep(); return enterStep(V.oStep - 1);
    case 'setNeg': D.neg = v === 'yes'; if(!D.neg) D.start = Math.abs(D.start); V.err = ''; return render();
    case 'setHorizon': D.horizon = v; V.err = ''; return render();
    case 'setFood': D.buysFood = v === 'yes'; V.err = ''; return render();
    case 'key':
      if(v === 'del') V.num = V.num.slice(0, -1);
      else if(v === ','){ if(!V.num.includes(',')) V.num = (V.num || '0') + ','; }
      else {
        const parts = V.num.split(',');
        if(parts.length === 2){ if(parts[1].length < 2) V.num += v; }
        else if(parts[0].length < 6) V.num = (V.num === '0' ? '' : V.num) + v;
      }
      V.err = ''; return render();
    case 'finish': return finishSetup();
    case 'newRec': V.ed = { kind: v, sub: 0, data: { type: v, name: '', amount: 0, rhythm: 'month', day: null, weekday: null, month: null } }; V.err = ''; render(); return window.scrollTo(0, 0);
    case 'newPot': V.ed = { kind: 'pot', sub: 0, data: { name: '', emoji: '👕', photo: null, amount: 0 } }; V.err = ''; render(); return window.scrollTo(0, 0);
    case 'delRec': { const r = D.rec.find(x => x.id === v); return ask(`Willst du „${r.name}“ wirklich löschen?`, 'Ja, löschen', () => { D.rec = D.rec.filter(x => x.id !== v); }, true); }
    case 'delPot': { const p = D.pots.find(x => x.id === v); return ask(`Willst du den Geld-Topf „${p.name}“ wirklich löschen?`, 'Ja, löschen', () => { D.pots = D.pots.filter(x => x.id !== v); }, true); }

    // Assistent
    case 'edNext': return edNext();
    case 'edBack':
      V.err = '';
      if(V.ed.sub === 0){ V.ed = null; return render(); }
      if(V.ed.sub === 2 && V.ed.kind !== 'pot') V.ed.data.amount = numToCents(V.num);
      V.ed.sub--;
      if(V.ed.sub === 1) V.num = centsToNum(V.ed.data.amount);
      return render();
    case 'edRestart': V.ed.sub = 0; V.err = ''; return render();
    case 'edChip': V.ed.data.name = v; V.err = ''; return render();
    case 'edEmoji': V.ed.data.emoji = v; V.ed.data.photo = null; return render();
    case 'edRhythm': V.ed.data.rhythm = v; V.err = ''; return render();
    case 'edWeekday': V.ed.data.weekday = +v; V.err = ''; return render();
    case 'edDay': V.ed.data.day = +v; V.err = ''; return render();
    case 'edMonth': V.ed.data.month = +v; V.err = ''; return render();
    case 'edSave': {
      if(V.ed.target === 'store'){ storeSaveEditor(); V.ed = null; toast('Gespeichert ✓'); render(); return window.scrollTo(0, 0); }
      const x = V.ed.data;
      if(V.ed.kind === 'pot') D.pots.push({ id: uid(), name: x.name, emoji: x.emoji, photo: x.photo, amount: x.amount });
      else {
        const r = { id: uid(), type: x.type, name: x.name, amount: x.amount, rhythm: x.rhythm };
        if(x.rhythm === 'week') r.weekday = x.weekday; else r.day = x.day;
        if(x.rhythm === 'year') r.month = x.month;
        D.rec.push(r);
      }
      V.ed = null; toast('Gespeichert ✓'); render(); return window.scrollTo(0, 0);
    }

    // Dialog
    case 'dlg': { const b = dialogBtns[+v]; V.modal = null; dialogBtns = []; if(b && b.fn) b.fn(); return render(); }

    // Einstellungen / Test
    case 'toggle': S.settings[v] = !S.settings[v]; save(); return render();
    case 'toggleHorizon': S.settings.horizon = S.settings.horizon === 'payday' ? 'month' : 'payday'; save(); return render();
    case 'shiftDay': S.settings.testDate = addDays(today(), +v); save(); return render();
    case 'shiftMonth': {
      const [y, m, d] = pd(today()); let nm = m + (+v), ny = y;
      if(nm < 1){ nm = 12; ny--; } if(nm > 12){ nm = 1; ny++; }
      S.settings.testDate = ds(ny, nm, Math.min(d, dim(ny, nm))); save(); return render();
    }
    case 'realToday': S.settings.testDate = null; save(); return render();
    case 'example': return ask('Beispiel-Daten laden? Deine jetzigen Daten werden dabei überschrieben.', 'Ja, laden', () => { loadExample(v); V.view = 'B'; toast('Beispiel geladen ✓'); }, true);
    case 'reset': return ask('Willst du wirklich ALLES löschen und neu anfangen? Das kann man nicht rückgängig machen.', 'Ja, alles löschen', () => {
      requirePin('Zur Sicherheit: Gib deine PIN ein, um alles zu löschen.', doReset);
    }, true);
  }
}

/* ---------- Ereignisse ---------- */
app.addEventListener('click', e => {
  const el = e.target.closest('[data-a]');
  if(!el || el.tagName === 'LABEL') return;
  if(el.dataset.a === 'startTap' && e.target.closest('button') && e.target.closest('button') !== el) return;
  act(el.dataset.a, el.dataset.v);
});
app.addEventListener('input', e => {
  const k = e.target.dataset.in;
  if(k === 'name'){ D.name = e.target.value; }
  if(k === 'txText'){ V.tx.text = e.target.value; }
  if(k === 'newName'){ V.newName = e.target.value; }
  if(k === 'edName'){ V.ed.data.name = e.target.value; const b = app.querySelector('.tile b'); if(b) b.textContent = 'Geld für ' + (e.target.value || '…'); }
});
app.addEventListener('change', e => {
  const k = e.target.dataset.in;
  if(k === 'testDate' && e.target.value){ S.settings.testDate = e.target.value; save(); render(); }
  if(k === 'photo' && e.target.files && e.target.files[0]) shrinkPhoto(e.target.files[0]);
  if(k === 'importFile' && e.target.files && e.target.files[0]){ const rd = new FileReader(); rd.onload = () => importData(rd.result); rd.readAsText(e.target.files[0]); }
});
app.addEventListener('keydown', e => {
  if(e.key === 'Enter' && e.target.tagName === 'INPUT' && e.target.type === 'text'){
    e.preventDefault();
    if(V.ed) return act('edNext');
    if(V.view === 'D' || V.view === 'E') return act('txNext');
    if(V.view === 'G'){ if(V.gsub === 'name') act('saveName'); if(V.gsub === 'forgot') act('checkCode'); return; }
    act('onext');
  }
});
function shrinkPhoto(file){
  const rd = new FileReader();
  rd.onload = () => {
    const img = new Image();
    img.onload = () => {
      const max = 300, sc = Math.min(1, max / Math.max(img.width, img.height));
      const cv = document.createElement('canvas'); cv.width = Math.round(img.width * sc); cv.height = Math.round(img.height * sc);
      cv.getContext('2d').drawImage(img, 0, 0, cv.width, cv.height);
      V.ed.data.photo = cv.toDataURL('image/jpeg', 0.8); render();
    };
    img.src = rd.result;
  };
  rd.readAsDataURL(file);
}

render();

/* Offline-Modus: nur auf der eigenen Website (z. B. GitHub Pages), nicht in der Vorschau */
try {
  const framed = window.self !== window.top;
  if(!framed && 'serviceWorker' in navigator && location.protocol === 'https:')
    navigator.serviceWorker.register('sw.js').catch(() => {});
} catch(e){}
