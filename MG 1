function moneyBar(c, H){
  const st = S.settings;
  const need = c.pending + c.RE;
  const scale = Math.max(c.frame, c.pool, need, 1);
  const px = v => Math.max(0, v) / scale * H;
  const bal = c.pool;
  const g = Math.min(c.pending, bal), f = Math.min(c.RE, bal - g), fr = bal - g - f;
  let y = 0, html = '';
  const seg = (cls, v) => { if(v <= 0) return; html += `<div class="seg ${cls}" style="bottom:${px(y)}px;height:${px(v)}px"></div>`; y += v; };
  seg('grey', g); seg('food', f); seg('free', fr);
  const have = Math.max(0, c.bal);
  if(c.pool > have) html += `<div class="seg coming" style="bottom:${px(have)}px;height:${px(c.pool - have)}px"></div>`;
  if(need > bal) html += `<div class="seg short" style="bottom:${px(bal)}px;height:${px(need - bal)}px"></div>`;
  if(c.saved > 0 && c.bal - c.saved > 0) html += `<div class="saveline" style="bottom:${px(c.bal - c.saved)}px"></div>`;
  return `<div class="bar" role="img" aria-label="${esc(`${c.title}: ${money(c.bal)}`)}">${html}</div>`;
}
