/* Vorschläge: In den letzten 3 vollen Monaten immer > 20 % mehr oder weniger ausgegeben */
function potSuggestions(){
  if(!S.start) return [];
  const t = today(); let [y, m] = pd(t);
  const months = [];
  for(let i = 0; i < 3; i++){ m--; if(m < 1){ m = 12; y--; } months.push([y, m]); }
  if(ds(months[2][0], months[2][1], 1) < S.start.date) return [];   // noch keine 3 vollen Monate
  const cur = t.slice(0, 7), out = [];
  for(const p of S.pots){
    if(p.food && !S.settings.buysFood) continue;
    if(!p.amount || (S.dismissed && S.dismissed[p.id] === cur)) continue;
    const r = months.map(([yy, mm]) => {
      const a = ds(yy, mm, 1), e = ds(yy, mm, dim(yy, mm));
      const spent = sum(S.bookings.filter(b => b.type === 'out' && b.potId === p.id && b.date >= a && b.date <= e));
      const plan = p.food ? p.amount * dim(yy, mm) : p.amount;
      return { spent, plan, days: dim(yy, mm) };
    });
    const more = r.every(x => x.spent > x.plan * 1.2), less = r.every(x => x.spent < x.plan * 0.8);
    if(!more && !less) continue;
    const avg = sum(r.map(x => ({ amount: x.spent }))) / 3;
    let sug;
    if(p.food){ sug = Math.max(500, Math.round(avg / 30 / 50) * 50); }
    else sug = Math.max(500, Math.round(avg / 500) * 500);
    if(sug === p.amount) continue;
    out.push({ p, more, sug });
  }
  return out;
}
function savedByMonth(){
  if(!S.start) return [];
  const t = today(), res = [];
  let [y, m] = pd(addDays(S.start.date, 1));
  const [ty, tm] = pd(t);
  while(y < ty || (y === ty && m < tm)){
    const e = ds(y, m, dim(y, m)), prev = addDays(ds(y, m, 1), -1);
    const before = prev < S.start.date ? S.start.amount : balance(prev);
    res.push({ y, m, diff: balance(e) - before });
    if(++m > 12){ m = 1; y++; }
  }
  return res;
}
