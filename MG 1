/* PIN + Notfall-Code: nur eine Hürde gegen Versehen, keine echte Sicherheit */
function hashStr(str){ let h = 0x811c9dc5; for(const ch of 'mein-geld:' + str){ h ^= ch.codePointAt(0); h = Math.imul(h, 0x01000193) >>> 0; } return h.toString(16); }
function newCode(){
  const A = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789'; let c = '';
  const r = new Uint32Array(8); try { crypto.getRandomValues(r); } catch(e){ for(let i = 0; i < 8; i++) r[i] = Math.random() * 1e9; }
  for(let i = 0; i < 8; i++){ c += A[r[i] % A.length]; if(i === 3) c += '-'; }
  return c;
}
const hasPin = () => !!(S.security && S.security.pinHash);
function pinOk(p){ return hasPin() && hashStr(p) === S.security.pinHash; }
/* Wichtige Aktionen brauchen die PIN noch einmal (falls eine PIN festgelegt ist) */
let pinThen = null;
function requirePin(why, fn){
  if(!hasPin()){ fn(); return; }
  pinThen = fn; V.pinWhy = why; V.gsub = 'pinCheck'; V.pinBuf = ''; V.err = '';
}
