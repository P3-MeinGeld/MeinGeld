/* Vorlesen: Bildschirm ist gesperrt, einmal Tippen beendet es */
function speak(text){
  if(!('speechSynthesis' in window)){ toast('Vorlesen geht auf diesem Gerät nicht'); return; }
  stopSpeak();
  const ov = document.createElement('div');
  ov.className = 'speakov'; ov.id = 'speakov';
  ov.innerHTML = `<div class="big">🔊</div><div>Ich lese vor …</div><div class="muted">Tippe, um aufzuhören.</div>`;
  ov.addEventListener('click', stopSpeak);
  document.body.appendChild(ov);
  try {
    const u = new SpeechSynthesisUtterance(text); u.lang = 'de-DE'; u.rate = 0.9;
    u.onend = u.onerror = () => { const o = document.getElementById('speakov'); if(o) o.remove(); };
    speechSynthesis.speak(u);
  } catch(e){ stopSpeak(); }
}
function stopSpeak(){ try { speechSynthesis.cancel(); } catch(e){} const o = document.getElementById('speakov'); if(o) o.remove(); }
