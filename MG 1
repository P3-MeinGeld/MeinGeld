<body>
<div id="app"></div>
<script>
'use strict';
/* =========================================================
   MEIN GELD
   Schritt 1: Datenmodell, Rechenlogik, Seite A + O
   Schritt 3: Seite B
   ========================================================= */

/* ---------- Speicher ---------- */
const KEY = 'meinGeld.v1';
let storageOk = true;
function defaultSettings(){
  return { devMode: true, testDate: null, readAloud: true, fontSize: 'normal', showCents: true,
           horizon: 'month',   // 'month' = bis Monatsende, 'payday' = bis zum nächsten Geld-Tag
           buysFood: true };   // Kauft die Person von dem Geld ihr Essen?
}
function blank(){
  return {
    version: 1,
    setupDone: false,
    profile: { name: '' },
    settings: defaultSettings(),
    start: null,            // { amount (Cent, kann negativ sein), date 'JJJJ-MM-TT' }
    recurring: [],          // { id, type:'in'|'out', name, amount, rhythm:'week'|'month'|'year', weekday, day, month, validFrom, validTo }
    pots: [],               // { id, food:bool, name, emoji, photo, amount }  Essen: pro Tag, sonst pro Monat
    bookings: []            // { id, type:'in'|'out', date, amount, text, potId }
  };
}
let S;
try { S = JSON.parse(localStorage.getItem(KEY)) || blank(); }
catch(e){ S = blank(); storageOk = false; }
S.settings = Object.assign(defaultSettings(), S.settings || {});
function save(){ try { localStorage.setItem(KEY, JSON.stringify(S)); } catch(e){ storageOk = false; } }
const uid = () => Math.random().toString(36).slice(2, 10);

/* ---------- Datum ---------- */
const pad = n => String(n).padStart(2, '0');
const ds = (y, m, d) => `${y}-${pad(m)}-${pad(d)}`;
const pd = s => s.split('-').map(Number);
const dim = (y, m) => new Date(y, m, 0).getDate();
const toDate = s => { const [y, m, d] = pd(s); return new Date(y, m - 1, d); };
const fromDate = D => ds(D.getFullYear(), D.getMonth() + 1, D.getDate());
const addDays = (s, n) => { const D = toDate(s); D.setDate(D.getDate() + n); return fromDate(D); };
const diffDays = (a, b) => Math.round((toDate(b) - toDate(a)) / 864e5);
const maxS = (a, b) => a > b ? a : b;
const minS = (a, b) => a < b ? a : b;
const realToday = () => fromDate(new Date());
const today = () => (S.settings.devMode && S.settings.testDate) || realToday();
const WD = ['Sonntag','Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'];
const WD_SHORT = ['So','Mo','Di','Mi','Do','Fr','Sa'];
const MON = ['Januar','Februar','März','April','Mai','Juni','Juli','August','September','Oktober','November','Dezember'];
function fmtDate(s){ const [y,m,d] = pd(s); return `${WD[toDate(s).getDay()]}, ${d}. ${MON[m-1]} ${y}`; }
function fmtDay(s){ const [,m,d] = pd(s); return `${d}. ${MON[m-1]}`; }

/* ---------- Geld ---------- */
function money(c){
  const o = S.settings.showCents ? {minimumFractionDigits:2, maximumFractionDigits:2} : {maximumFractionDigits:0};
  return new Intl.NumberFormat('de-DE', o).format(c / 100).replace('-', '−') + '\u00a0€';
}
function numToCents(s){
  if(!s) return 0;
  const [a, b = ''] = s.split(',');
  return (parseInt(a || '0', 10) * 100) + parseInt((b + '00').slice(0, 2), 10);
}
function centsToNum(c){
  if(!c) return '';
  const e = Math.floor(c / 100), r = c % 100;
  return r ? `${e},${pad(r)}`.replace(/0$/, '') : String(e);
}
const sum = list => list.reduce((a, x) => a + x.amount, 0);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

/* =========================================================
   RECHENLOGIK
   ========================================================= */

/* Termine einer regelmäßigen Zahlung zwischen from und to (inklusive).
   "Am 31." wird in kürzeren Monaten am letzten Tag gebucht. */
function occ(r, from, to){
  let a = from, b = to;
  if(r.validFrom) a = maxS(a, r.validFrom);
  if(r.validTo) b = minS(b, r.validTo);
  if(a > b) return [];
  const out = [];
  const [ay, am] = pd(a), [by, bm] = pd(b);
  if(r.rhythm === 'month'){
    let y = ay, m = am;
    while(y < by || (y === by && m <= bm)){
      const s = ds(y, m, Math.min(r.day, dim(y, m)));
      if(s >= a && s <= b) out.push(s);
      if(++m > 12){ m = 1; y++; }
    }
  } else if(r.rhythm === 'year'){
    for(let y = ay; y <= by; y++){
      const s = ds(y, r.month, Math.min(r.day, dim(y, r.month)));
      if(s >= a && s <= b) out.push(s);
    }
  } else {
    const D = toDate(a);
    D.setDate(D.getDate() + ((r.weekday - D.getDay() + 7) % 7));
    for(let s = fromDate(D); s <= b; s = addDays(s, 7)) out.push(s);
  }
  return out;
}

/* Alle Buchungen zwischen from und to.
   Regelmäßige werden erst NACH dem Starttag gebucht (am Starttag steckt alles im Startbetrag).
   ignoreStart=true: Plan für den ganzen Monat, unabhängig vom Starttag. */
function txs(from, to, ignoreStart){
  const list = [];
  for(const b of S.bookings) if(b.date >= from && b.date <= to) list.push({ ...b, kind: 'once' });
  let rf = from;
  if(!ignoreStart && S.start) rf = maxS(rf, addDays(S.start.date, 1));
  for(const r of S.recurring)
    for(const d of occ(r, rf, to))
      list.push({ id: r.id + '@' + d, recId: r.id, date: d, type: r.type, amount: r.amount, text: r.name, kind: 'rec' });
  return list.sort((x, y) => x.date < y.date ? -1 : x.date > y.date ? 1 : 0);
}

function balance(asOf){
  if(!S.start || asOf < S.start.date) return 0;
  let v = S.start.amount;
  for(const t of txs(S.start.date, asOf)) v += t.type === 'in' ? t.amount : -t.amount;
  return v;
}

/* Nächster / letzter Geld-Tag = Termin einer regelmäßigen Einnahme */
const activeIncomes = () => S.recurring.filter(r => r.type === 'in' && !r.validTo);
function nextPayday(t){
  let best = null;
  for(const r of activeIncomes()){ const o = occ(r, addDays(t, 1), addDays(t, 400)); if(o.length && (!best || o[0] < best)) best = o[0]; }
  return best;
}
function lastPayday(t){
  let best = null;
  for(const r of activeIncomes()){ const o = occ(r, addDays(t, -400), t); if(o.length){ const x = o[o.length - 1]; if(!best || x > best) best = x; } }
  return best;
}

function calc(){
  const t = today();
  const [y, m, d] = pd(t);
  const n = dim(y, m);
  const mS = ds(y, m, 1), mE = ds(y, m, n);
  const st = S.settings;

  const bal = balance(t);
  const plan = txs(mS, mE, true).filter(x => x.kind === 'rec');
  const monthIn  = sum(plan.filter(x => x.type === 'in'));
  const monthFix = sum(plan.filter(x => x.type === 'out'));

  // Zeitraum: bis Monatsende oder bis zum nächsten Geld-Tag
  let mode = 'month', E = mE, left = n - d + 1, pStart = mS, frame = monthIn, payday = null;
  let title = `Geld für ${MON[m - 1]}`, until = 'bis zum Monatsende';
  if(st.horizon === 'payday'){
    const np = nextPayday(t);
    if(np){
      mode = 'payday'; payday = np; E = addDays(np, -1); left = diffDays(t, np);
      const lp = lastPayday(t);
      pStart = lp ? lp : (S.start ? S.start.date : t);
      frame = lp ? sum(activeIncomes().filter(r => occ(r, lp, lp).length)) : 0;
      const name = left <= 7 ? WD[toDate(np).getDay()] : fmtDay(np);
      title = `Geld bis ${name}`; until = left <= 7 ? `bis ${name}` : `bis zum ${fmtDay(np)}`;
    }
  }
  if(S.start) pStart = maxS(pStart, S.start.date);

  // Regelmäßige Zahlungen, die bis zum Ende des Zeitraums noch kommen
  const later = t < E ? txs(addDays(t, 1), E).filter(x => x.kind === 'rec') : [];
  const pendList = later.filter(x => x.type === 'out');
  const pending = sum(pendList);
  const pendingIn = sum(later.filter(x => x.type === 'in'));   // Geld, das sicher noch kommt
  const pool = Math.max(0, bal + pendingIn);                    // Geld jetzt + Geld, das noch kommt
  const free = bal + pendingIn - pending;

  const food = S.pots.find(p => p.food);
  const perDay = (st.buysFood && food) ? food.amount : 0;
  const RE = perDay * left;
  const dayMoney = left > 0 ? Math.floor(Math.max(0, free) / left) : 0;

  const prevEnd = addDays(pStart, -1);
  const saved = (S.start && prevEnd >= S.start.date) ? Math.max(0, balance(prevEnd)) : 0;

  const soFar = S.start ? txs(maxS(mS, S.start.date), t) : [];
  const inSoFar  = sum(soFar.filter(x => x.type === 'in'));
  const outSoFar = sum(soFar.filter(x => x.type === 'out'));

  const pots = S.pots.filter(p => !p.food || st.buysFood).map(p => {
    const monthly = p.food ? p.amount * n : p.amount;
    const spent = sum(S.bookings.filter(b => b.type === 'out' && b.potId === p.id && b.date >= mS && b.date <= mE));
    return { ...p, monthly, spent, rest: monthly - spent };
  });

  const warnings = [];
  if(bal < 0) warnings.push({ level: 'red', text: `Achtung! Du hast kein Geld mehr. Du bist ${money(-bal)} im Minus.` });
  else if(free < 0) warnings.push({ level: 'red', text: `Achtung! Dein Geld reicht nicht für die festen Kosten ${until}. Es fehlen ${money(-free)}.` });
  if(st.buysFood && free < RE) warnings.push({ level: 'red', text: `Achtung! Dein Geld reicht nicht mehr fürs Essen ${until}. Es fehlen ${money(RE - Math.max(free, 0))}.` });
  for(const p of pots){
    if(p.food || p.monthly <= 0) continue;
    if(p.rest < 0) warnings.push({ level: 'orange', text: `Dein Geld für ${p.name} ist für diesen Monat alle. Du hast ${money(-p.rest)} mehr ausgegeben.` });
    else if(p.rest === 0) warnings.push({ level: 'orange', text: `Dein Geld für ${p.name} ist für diesen Monat alle.` });
  }

  return { t, y, m, d, n, mS, mE, mode, E, left, pStart, frame, payday, title, until,
           bal, monthIn, monthFix, pending, pendList, pendingIn, pool, free, perDay, RE, dayMoney, saved, inSoFar, outSoFar, pots, warnings };
}

