function importData(txt){
  let data;
  try { data = JSON.parse(txt); } catch(e){ toast('Das sind keine gültigen Daten'); return; }
  if(!data || data.version !== 1 || !Array.isArray(data.bookings)){ toast('Das sind keine gültigen Daten'); return; }
  ask('Daten wiederherstellen? Die jetzigen Daten werden dabei überschrieben.', 'Ja, wiederherstellen', () =>
    requirePin('Zur Sicherheit: Gib deine PIN ein, um die Daten zu überschreiben.', () => {
      S = data; S.settings = Object.assign(defaultSettings(), S.settings || {}); save(); V.gsub = null; V.unlocked = false; toast('Wiederhergestellt ✓');
    }), true);
}
function storeSaveEditor(){
  const E = V.ed, x = E.data, t = today();
  if(E.kind === 'pot'){
    if(E.editId){ const p = S.pots.find(p => p.id === E.editId); Object.assign(p, { name: x.name, emoji: x.emoji, photo: x.photo, amount: x.amount }); }
    else S.pots.push({ id: uid(), name: x.name, emoji: x.emoji, photo: x.photo, amount: x.amount });
  } else {
    const r = { id: uid(), type: x.type, name: x.name, amount: x.amount, rhythm: x.rhythm, validFrom: t, validTo: null };
    if(x.rhythm === 'week') r.weekday = x.weekday; else r.day = x.day;
    if(x.rhythm === 'year') r.month = x.month;
    if(E.editId){ const old = S.recurring.find(o => o.id === E.editId); if(old) old.validTo = addDays(t, -1); }
    S.recurring.push(r);
  }
  save();
}
function doReset(){
  const dev = S.settings.devMode, td = S.settings.testDate;
  S = blank(); S.settings.devMode = dev; S.settings.testDate = td; save();
  V.view = 'A'; V.gsub = null; V.unlocked = false;
}
function pinDigit(){
  const p = V.pinBuf; V.pinBuf = ''; V.err = '';
  if(!V.unlocked && hasPin() && !V.gsub){
    if(pinOk(p)){ V.unlocked = true; } else V.err = 'Die PIN stimmt nicht. Versuch es noch einmal.';
    return;
  }
  if(V.gsub === 'pinNew1'){ V.pinFirst = p; V.gsub = 'pinNew2'; return; }
  if(V.gsub === 'pinNew2'){
    if(p !== V.pinFirst){ V.gsub = 'pinNew1'; V.err = 'Die PINs waren nicht gleich. Fang noch einmal an.'; return; }
    V.newCode = newCode();
    S.security = { pinHash: hashStr(p), codeHash: hashStr(V.newCode.replace('-', '')) };
    save(); V.unlocked = true; V.gsub = 'code'; return;
  }
  if(V.gsub === 'pinCheck'){
    if(pinOk(p)){ const f = pinThen; pinThen = null; V.gsub = null; if(f) f(); }
    else V.err = 'Die PIN stimmt nicht. Versuch es noch einmal.';
  }
}

