function edNext(){
  const E = V.ed, x = E.data; V.err = '';
  const fail = msg => { V.err = msg; render(); };
  if(E.sub === 0){ if(!(x.name || '').trim()) return fail(E.kind === 'pot' ? 'Bitte schreib, wofür der Geld-Topf ist.' : 'Bitte schreib, wofür das Geld ist.'); x.name = x.name.trim(); V.num = centsToNum(x.amount); }
  if(E.sub === 1){
    x.amount = numToCents(V.num); if(!x.amount) return fail('Bitte gib einen Betrag ein.');
    if(x.food && x.amount < 500){
      const next = () => { E.sub++; setTimeout(() => window.scrollTo(0, 0)); };
      return dialog(`Du hast ${money(x.amount)} am Tag eingegeben. Das ist sehr wenig für einen ganzen Tag. Unser Vorschlag: 5\u00a0€ am Tag.`, [
        { label: '5\u00a0€ nehmen', cls: 'primary', fn: () => { x.amount = 500; next(); } },
        { label: `Bei ${money(x.amount)} bleiben`, fn: next },
        { label: 'Neuen Betrag eingeben', fn: () => { V.num = ''; } }
      ]);
    }
  }
  if(E.kind !== 'pot'){
    if(E.sub === 2 && !x.rhythm) return fail('Bitte wähl aus, wie oft.');
    if(E.sub === 3){
      if(x.rhythm === 'week' && x.weekday == null) return fail('Bitte wähl einen Tag.');
      if(x.rhythm === 'month' && !x.day) return fail('Bitte wähl einen Tag.');
      if(x.rhythm === 'year' && (!x.day || !x.month)) return fail('Bitte wähl Monat und Tag.');
    }
  }
  E.sub++; render(); window.scrollTo(0, 0);
}

